# Base URL of the REST API (versioned /api/v1).
# When unset, the app runs in mock-data mode using src/lib/mock/.
NEXT_PUBLIC_API_BASE_URL=https://api.tpq-qurani.example.id/api/v1

# Canonical site URL for SEO metadata and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://tpq-qurani.example.id

# Google Analytics 4 measurement ID (enables page_view tracking).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
